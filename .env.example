# Spark — Convex backend environment variables
#
# Where they live: these are CONVEX deployment env vars. Set them with
#   npx convex env set NAME value            (dev deployment)
#   npx convex env set NAME value --prod     (production)
# Local shell copies in .env.local are only for the CLI; the functions read
# process.env on the Convex deployment.
#
# REQUIRED — the product does not run without these
# ---------------------------------------------------------------------------

# Clerk (auth + orgs). Create a Clerk app, add a JWT template named "convex",
# then copy the issuer domain (https://<slug>.clerk.accounts.dev).
CLERK_JWT_ISSUER_DOMAIN=

# Clerk webhook signing secret for POST /clerk/webhooks (team/org sync).
# Clerk dashboard → Webhooks → endpoint https://<deployment>.convex.site/clerk/webhooks
CLERK_WEBHOOK_SECRET=

# Anthropic — all reasoning (chat, extraction, synthesis, linter, agents).
# Read implicitly by the SDK. Per-org BYOK override: orgs.anthropicApiKey.
ANTHROPIC_API_KEY=

# OpenAI — embeddings only (text-embedding-3-large via @convex-dev/rag).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# INTEGRATIONS — required for signal intake from real tools
# ---------------------------------------------------------------------------

# Composio (Slack + Asana triggers, OAuth Connect Links, agent tool delivery).
# Create a Composio project; one API key serves all orgs (user_id = orgId).
COMPOSIO_API_KEY=

# Composio webhook subscription secret. Create ONE subscription per project:
#   POST /api/v3.1/webhook_subscriptions
#   { "webhook_url": "https://<deployment>.convex.site/ingest",
#     "enabled_events": ["composio.trigger.message"] }
# and store its signing secret here.
COMPOSIO_WEBHOOK_SECRET=

# Composio auth-config IDs (Composio dashboard → Auth Configs) for the wired
# toolkits. Without them, the Connect flow for that toolkit is unavailable.
SLACK_AUTH_CONFIG_ID=
ASANA_AUTH_CONFIG_ID=

# GitHub App webhook secret. GitHub is NOT Composio: create a GitHub App
# (webhook URL https://<deployment>.convex.site/ingest), subscribe to the
# events you want, install it on the customer org, then link installation.id
# to the Spark org in Settings. One app-level secret authenticates deliveries.
GITHUB_APP_WEBHOOK_SECRET=

# GitHub App slug (the URL name: github.com/apps/<slug>). Used to build the
# self-serve install link; the app's Setup URL must point at
# https://<deployment>.convex.site/github/setup with "Redirect on update" on.
GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# MCP SERVER — required for external agents and Managed Agent tool access
# ---------------------------------------------------------------------------

# Public URL of this deployment's MCP endpoint, e.g.
# https://<deployment>.convex.site/mcp
SPARK_MCP_URL=

# HMAC secret for short-lived managed-MCP tokens (Managed Agent sessions →
# Spark MCP). Generate: openssl rand -hex 32
SPARK_MCP_SIGNING_SECRET=

# Comma-separated list of allowed browser origins for the MCP endpoint
# (CORS). Non-browser MCP clients are unaffected.
MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# OPTIONAL — degrade gracefully when unset
# ---------------------------------------------------------------------------

# Cohere reranker for deep search. Unset = hybrid search skips reranking.
COHERE_API_KEY=
